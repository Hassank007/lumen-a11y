# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Copy to .env.local and fill in. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: reCAPTCHA site key (optional during development — debug tokens are used instead)
VITE_RECAPTCHA_SITE_KEY=
# Set to "true" in development to print an App Check debug token in the side panel console
VITE_APPCHECK_DEBUG=true
# Optional fixed App Check debug token (register it in the Firebase console)
VITE_APPCHECK_DEBUG_TOKEN=
